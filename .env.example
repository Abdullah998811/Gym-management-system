# Titan Gym Management System - Environment Configuration Template
# Copy this file to .env for local development

APP_ENV=development
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000

# Security: Generate a strong 32-byte (64 hex characters) key using:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-key

# Database: Default SQLite fallback if omitted
DATABASE_URL=sqlite:///gym_management.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://user:password@localhost:5432/gym_management

# Session Settings (Session timeout in minutes)
SESSION_LIFETIME_MINUTES=30
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Optional Development Seeding Passwords:
# SEED_ADMIN_PASSWORD=Admin@12345
